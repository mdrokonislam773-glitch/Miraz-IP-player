<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIRAJ GLOBAL IPTV - এ টু জেড আপডেট</title>
    
    <!-- Video.js CSS -->
    <link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #00ff66; 
            --bg-color: #0a0f0d;      
            --card-bg: #141f19;       
            --text-color: #ffffff;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Hind Siliguri', sans-serif;
            margin: 0; padding-bottom: 50px;
        }

        header {
            background-color: #000;
            padding: 20px;
            text-align: center;
            border-bottom: 3px solid var(--primary-color);
            position: sticky; top: 0; z-index: 1000;
        }

        header h1 { font-size: 26px; margin: 0; }
        header h1 span { color: var(--primary-color); }

        .search-container { margin: 15px 0; }
        .search-box {
            width: 90%; max-width: 500px;
            padding: 12px 20px; border-radius: 25px;
            border: 2px solid #223a2b; background: #111a14;
            color: white; outline: none;
        }

        .main-content { max-width: 1200px; margin: 0 auto; padding: 20px; }

        .player-wrapper {
            background: #000; border-radius: 12px;
            overflow: hidden; margin-bottom: 30px;
            border: 1px solid #1a2e22; box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }

        .video-container { position: relative; padding-top: 56.25%; }
        .video-js { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

        .category-title {
            font-size: 22px; margin: 30px 0 15px;
            border-left: 5px solid var(--primary-color);
            padding-left: 15px; color: var(--primary-color);
            font-weight: 700;
        }

        .channel-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 15px;
        }

        .channel-card {
            background: var(--card-bg); border-radius: 10px;
            padding: 12px; text-align: center; cursor: pointer;
            transition: 0.3s; border: 1px solid #1f3326;
        }

        .channel-card:hover { transform: translateY(-5px); border-color: var(--primary-color); }

        .logo-container {
            background: white; width: 100%; height: 75px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 10px; padding: 5px;
        }

        .logo-container img { max-width: 100%; max-height: 100%; object-fit: contain; }

        .channel-card p { font-size: 14px; font-weight: 600; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        
        .active { border-color: var(--primary-color); background: #0c2415; }
    </style>
</head>
<body>

<header>
    <h1>MIRAJ <span>GLOBAL PLAYER</span></h1>
    <div class="search-container">
        <input type="text" id="searchInput" class="search-box" placeholder="চ্যানেল বা ক্যাটাগরি খুঁজুন..." onkeyup="filterChannels()">
    </div>
</header>

<div class="main-content">
    <div class="player-wrapper">
        <div class="video-container">
            <video id="iptv-player" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="auto">
                <source src="" type="application/x-mpegURL">
            </video>
        </div>
    </div>

    <div id="categories-container"></div>
</div>

<script src="https://vjs.zencdn.net/7.20.3/video.min.js"></script>

<script>
    const channels = [
        // --- BANGLADESH (২০+ চ্যানেল) ---
        { name: "Somoy TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/2/23/Somoy_TV_Logo.png", url: "https://moctv.b-cdn.net/live/somoytv.stream/playlist.m3u8" },
        { name: "Jamuna TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/commons/2/2a/Jamuna_TV_logo.png", url: "https://moctv.b-cdn.net/live/jamunatv.stream/playlist.m3u8" },
        { name: "Independent TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/0/05/Independent_Television_logo.svg/1200px-Independent_Television_logo.svg.png", url: "https://moctv.b-cdn.net/live/independent.stream/playlist.m3u8" },
        { name: "Channel 24", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/8/87/Channel_24_Logo.png", url: "https://moctv.b-cdn.net/live/channel24.stream/playlist.m3u8" },
        { name: "Ekattor TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/1/16/Ekattor_TV_logo.png", url: "https://moctv.b-cdn.net/live/ekattortv.stream/playlist.m3u8" },
        { name: "DBC News", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/3/30/DBC_News_logo.png", url: "https://moctv.b-cdn.net/live/dbcnews.stream/playlist.m3u8" },
        { name: "NTV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/commons/1/19/NTV_Bangladesh_Logo.png", url: "https://moctv.b-cdn.net/live/ntv.stream/playlist.m3u8" },
        { name: "RTV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/commons/f/f6/Rtv_logo_bd.png", url: "https://moctv.b-cdn.net/live/rtv.stream/playlist.m3u8" },
        { name: "Deepto TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/d/df/Deepto_TV_logo.png", url: "https://moctv.b-cdn.net/live/deeptotv.stream/playlist.m3u8" },
        { name: "Channel i", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/1/1e/Channel_i_logo.png", url: "https://moctv.b-cdn.net/live/channeli.stream/playlist.m3u8" },
        { name: "Banglavision", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/5/52/Banglavision_logo.png", url: "https://moctv.b-cdn.net/live/banglavision.stream/playlist.m3u8" },
        { name: "Desh TV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/a/ad/Desh_TV_logo.png", url: "https://moctv.b-cdn.net/live/deshtv.stream/playlist.m3u8" },
        { name: "BTV", cat: "Bangladesh", logo: "https://upload.wikimedia.org/wikipedia/en/b/bd/BTV_logo.png", url: "https://moctv.b-cdn.net/live/btv.stream/playlist.m3u8" },

        // --- SPORTS ---
        { name: "T Sports", cat: "Sports", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/8/87/T_Sports_logo.svg/1200px-T_Sports_logo.svg.png", url: "https://moctv.b-cdn.net/live/tsports.stream/playlist.m3u8" },
        { name: "GTV Live", cat: "Sports", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/8/80/Gazi_Television_logo.svg/1200px-Gazi_Television_logo.svg.png", url: "https://moctv.b-cdn.net/live/gtv.stream/playlist.m3u8" },

        // --- ENTERTAINMENT (ভারত ও মুভি) ---
        { name: "Sony Aath", cat: "Entertainment", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/3/3b/Sony_Aath_logo.svg/1200px-Sony_Aath_logo.svg.png", url: "https://example.com/sonyaath.m3u8" },
        { name: "Jalsha Movies", cat: "Entertainment", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/0/05/Jalsha_Movies_logo.png/250px-Jalsha_Movies_logo.png", url: "https://example.com/jalsha.m3u8" },
        { name: "Star Jalsha", cat: "Entertainment", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/7/7b/Star_Jalsha_logo.png/250px-Star_Jalsha_logo.png", url: "https://example.com/starjalsha.m3u8" },
        { name: "Zee Bangla", cat: "Entertainment", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/5/52/Zee_Bangla_logo.png/220px-Zee_Bangla_logo.png", url: "https://example.com/zeebangla.m3u8" },

        // --- INTERNATIONAL ---
        { name: "Al Jazeera", cat: "International", logo: "https://upload.wikimedia.org/wikipedia/en/thumb/f/f2/Al_Jazeera_English_logo.svg/1200px-Al_Jazeera_English_logo.svg.png", url: "https://live-hls-web-aje.getaj.net/aje/index.m3u8" },
        { name: "NHK World", cat: "International", logo: "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/NHK_World_logo.svg/1200px-NHK_World_logo.svg.png", url: "https://nhkwlive-ojp.akamaized.net/hls/live/2003459/nhkwlive-ojp-en/master.m3u8" }
    ];

    const player = videojs('iptv-player');
    const container = document.getElementById('categories-container');

    function renderChannels(data) {
        container.innerHTML = "";
        const categories = [...new Set(data.map(item => item.cat))];

        categories.forEach(cat => {
            const section = document.createElement('div');
            section.innerHTML = `<div class="category-title">${cat}</div>`;
            const grid = document.createElement('div');
            grid.className = 'channel-grid';

            data.filter(c => c.cat === cat).forEach(channel => {
                const card = document.createElement('div');
                card.className = 'channel-card';
                card.innerHTML = `
                    <div class="logo-container"><img src="${channel.logo}" onerror="this.src='https://via.placeholder.com/150?text=TV'"></div>
                    <p>${channel.name}</p>
                `;
                card.onclick = () => {
                    document.querySelectorAll('.channel-card').forEach(c => c.classList.remove('active'));
                    card.classList.add('active');
                    player.src({ src: channel.url, type: 'application/x-mpegURL' });
                    player.play();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                };
                grid.appendChild(card);
            });
            section.appendChild(grid);
            container.appendChild(section);
        });
    }

    function filterChannels() {
        const val = document.getElementById('searchInput').value.toLowerCase();
        const filtered = channels.filter(c => c.name.toLowerCase().includes(val) || c.cat.toLowerCase().includes(val));
        renderChannels(filtered);
    }

    renderChannels(channels);
    if(channels.length > 0) player.src({ src: channels[0].url, type: 'application/x-mpegURL' });
</script>
</body>
</html>
